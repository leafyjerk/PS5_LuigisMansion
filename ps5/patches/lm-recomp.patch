@@ -28,7 +28,16 @@ namespace recomp {
 
 namespace {
 bool sIrqPendingFlag = false;
+#if defined(__cpp_lib_atomic_ref)
 std::atomic_ref<bool> irqPending() { return std::atomic_ref<bool>(sIrqPendingFlag); }
+#else
+// libc++ before 19 (the PS5 payload SDK's) has no std::atomic_ref: the same accesses, by hand.
+struct IrqPendingRef {
+    void store(bool v) const { __atomic_store_n(&sIrqPendingFlag, v, __ATOMIC_SEQ_CST); }
+    bool load() const { return __atomic_load_n(&sIrqPendingFlag, __ATOMIC_SEQ_CST); }
+};
+IrqPendingRef irqPending() { return {}; }
+#endif
 }  // namespace
 bool* g_irqPending = &sIrqPendingFlag;  // read by guest code (Ctx::poll)
