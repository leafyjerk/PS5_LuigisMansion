 #ifdef LM_STATIC_MODULE
 std::string findDisc(const char* gameId) {
     if (!port::options().disc.empty()) return port::options().disc;
+#ifdef __PROSPERO__
+    // PS5: the player's disc image is in the title's folder, under any name ending in .iso (or
+    // .ciso): <gameId>.iso first, else the first one found. A title has no working folder.
+    std::error_code ec;
+    const std::filesystem::path title = "/app0";
+    if (const auto named = title / (std::string(gameId) + ".iso"); std::filesystem::exists(named, ec))
+        return named.string();
+    for (const auto& entry : std::filesystem::directory_iterator(title, ec)) {
+        const std::string ext = entry.path().extension().string();
+        if (entry.is_regular_file(ec) && (ext == ".iso" || ext == ".ISO" || ext == ".ciso" || ext == ".CISO"))
+            return entry.path().string();
+    }
+    return {};
+#endif
     for (auto dir = std::filesystem::current_path();; dir = dir.parent_path()) {
         const auto candidate = dir / "orig" / (std::string(gameId) + ".iso");
         if (std::filesystem::exists(candidate)) return candidate.string();
