+#if DAWN_PLATFORM_IS(PS5)
+        case Surface::Type::SwitchNWindow: {
+            // The console's VideoOut, as VK_KHR_display's first display in its first mode.
+            if (info.HasExt(InstanceExt::Display)) {
+                VkPhysicalDevice vkPhysicalDevice = physicalDevice->GetVkPhysicalDevice();
+                uint32_t count = 1;
+                VkDisplayPropertiesKHR display = {};
+                VkResult result = VkResult::WrapUnsafe(fn.GetPhysicalDeviceDisplayPropertiesKHR(
+                    vkPhysicalDevice, &count, &display));
+                if ((result != VK_SUCCESS && result != VK_INCOMPLETE) || count == 0) {
+                    return DAWN_INTERNAL_ERROR("GetPhysicalDeviceDisplayPropertiesKHR");
+                }
+                count = 1;
+                VkDisplayModePropertiesKHR mode = {};
+                result = VkResult::WrapUnsafe(fn.GetDisplayModePropertiesKHR(
+                    vkPhysicalDevice, display.display, &count, &mode));
+                if ((result != VK_SUCCESS && result != VK_INCOMPLETE) || count == 0) {
+                    return DAWN_INTERNAL_ERROR("GetDisplayModePropertiesKHR");
+                }
+
+                VkDisplaySurfaceCreateInfoKHR createInfo = {};
+                createInfo.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+                createInfo.displayMode = mode.displayMode;
+                createInfo.planeIndex = 0;
+                createInfo.planeStackIndex = 0;
+                createInfo.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+                createInfo.globalAlpha = 1.0f;
+                createInfo.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+                createInfo.imageExtent = mode.parameters.visibleRegion;
+
+                VkSurfaceKHR vkSurface = VK_NULL_HANDLE;
+                DAWN_TRY(CheckVkSuccess(
+                    fn.CreateDisplayPlaneSurfaceKHR(vkInstance, &createInfo, nullptr, &*vkSurface),
+                    "CreateDisplayPlaneSurfaceKHR"));
+                return vkSurface;
+            }
+            break;
+        }
+#endif  // DAWN_PLATFORM_IS(PS5)
